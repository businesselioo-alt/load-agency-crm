'use client';

import { useSyncExternalStore } from 'react';
import { Download, AlertTriangle, CheckCircle2 } from 'lucide-react';

/**
 * Page temporaire d'export.
 *
 * Les onglets Infos et Annex du module Management enregistraient dans le
 * localStorage du navigateur, jamais dans Supabase : leurs données n'existent
 * que sur la machine où elles ont été saisies. Avant de supprimer ces onglets,
 * cette page permet de les récupérer sans passer par la console.
 *
 * À supprimer une fois l'export fait.
 */

const KEYS = [
  { key: 'crm_model_annex_v1', label: 'Annex — fiches complètes des créatrices' },
  { key: 'crm_model_infos_v1', label: 'Infos — prénoms et usernames' },
];

/**
 * Le localStorage est une source externe : on le lit via useSyncExternalStore
 * plutôt que dans un effet, qui déclencherait un rendu en cascade. Le snapshot
 * est mis en cache pour rester stable entre les rendus.
 */
let cachedRaw = '';
let cachedSnapshot: Record<string, unknown> | null = null;

function readSnapshot(): Record<string, unknown> {
  const raw = KEYS.map(({ key }) => localStorage.getItem(key) ?? '').join('\u0000');
  if (raw !== cachedRaw || cachedSnapshot === null) {
    cachedRaw = raw;
    const data: Record<string, unknown> = {};
    KEYS.forEach(({ key }) => {
      try {
        data[key] = JSON.parse(localStorage.getItem(key) ?? '{}');
      } catch {
        data[key] = {};
      }
    });
    cachedSnapshot = data;
  }
  return cachedSnapshot;
}

function subscribe(cb: () => void) {
  window.addEventListener('storage', cb);
  return () => window.removeEventListener('storage', cb);
}

export default function ExportPage() {
  const payload = useSyncExternalStore(subscribe, readSnapshot, () => null);

  const counts: Record<string, number> = {};
  KEYS.forEach(({ key }) => {
    counts[key] = Object.keys((payload?.[key] as object) ?? {}).length;
  });
  const total = Object.values(counts).reduce((s, n) => s + n, 0);

  const download = () => {
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `load-agency-export-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <div className="min-h-screen bg-[#0a0a0a] flex items-start justify-center p-6 md:p-12">
      <div className="w-full max-w-2xl space-y-5">
        <div>
          <h1 className="text-2xl font-bold text-white mb-1">Export des données locales</h1>
          <p className="text-[#888] text-sm">
            Les onglets Infos et Annex enregistraient dans ce navigateur uniquement. Récupère leur
            contenu avant leur suppression.
          </p>
        </div>

        {payload === null ? (
          <div className="h-40 bg-[#111] rounded-2xl border border-[#1f1f1f] animate-pulse" />
        ) : (
          <>
            <div className="bg-[#111] border border-[#1f1f1f] rounded-2xl divide-y divide-[#1a1a1a]">
              {KEYS.map(({ key, label }) => (
                <div key={key} className="flex items-center gap-3 px-5 py-4">
                  {counts[key] > 0 ? (
                    <CheckCircle2 size={16} className="text-emerald-400 flex-shrink-0" />
                  ) : (
                    <AlertTriangle size={16} className="text-[#444] flex-shrink-0" />
                  )}
                  <div className="min-w-0 flex-1">
                    <p className="text-sm text-white">{label}</p>
                    <p className="text-[11px] text-[#555]">{key}</p>
                  </div>
                  <span
                    className={`text-sm font-semibold ${
                      counts[key] > 0 ? 'text-[#C9A84C]' : 'text-[#444]'
                    }`}
                  >
                    {counts[key]} fiche{counts[key] > 1 ? 's' : ''}
                  </span>
                </div>
              ))}
            </div>

            {total === 0 ? (
              <div className="px-4 py-3 rounded-xl border border-[#222] bg-[#0f0f0f] text-sm text-[#888]">
                Rien à exporter dans ce navigateur : les deux fiches sont vides. Tu peux supprimer
                les onglets sans risque. Si Sadie ou Kate ont saisi des données, elles doivent
                ouvrir cette page depuis leur propre machine.
              </div>
            ) : (
              <button
                onClick={download}
                className="flex items-center gap-2 px-4 py-2.5 bg-[#C9A84C] text-black rounded-xl text-sm font-semibold hover:bg-[#d9b95c] transition"
              >
                <Download size={15} />
                Télécharger l&apos;export ({total} fiche{total > 1 ? 's' : ''})
              </button>
            )}

            <details className="bg-[#111] border border-[#1f1f1f] rounded-2xl">
              <summary className="px-5 py-4 text-sm text-[#888] cursor-pointer hover:text-white transition">
                Voir le contenu brut
              </summary>
              <pre className="px-5 pb-5 text-[11px] text-[#666] overflow-x-auto whitespace-pre-wrap break-all">
                {JSON.stringify(payload, null, 2)}
              </pre>
            </details>
          </>
        )}
      </div>
    </div>
  );
}
